    replacement_chunks {
      replacement_content: "use rusqlite::Connection;\nuse std::collections::HashMap;\nuse chrono::Utc;\nuse crate::repositories::settings_repository::SettingsRepository;\n\npub struct SettingsService;\n\nimpl SettingsService {\n    pub fn get_settings_map(conn: &Connection) -> Result<HashMap<String, Option<String>>, String> {\n        let settings = SettingsRepository::get_all(conn).map_err(|e| e.to_string())?;\n        \n        let mut map = HashMap::new();\n        for s in settings {\n            map.insert(s.key, s.value);\n        }\n        \n        Ok(map)\n    }\n\n    pub fn save_setting(conn: &Connection, key: &str, value: Option<&str>) -> Result<(), String> {\n        let timestamp = Utc::now().to_rfc3339(); // ISO 8601 em UTC\n        SettingsRepository::upsert(conn, key, value, &timestamp).map_err(|e| e.to_string())?;\n        Ok(())\n    }\n}\n"
    }
